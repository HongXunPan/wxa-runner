<view class="container">
  <view class="header">
    <text class="title">wxa-runner 功能测试</text>
    <text class="version">v{{version}}</text>
  </view>

  <view class="section">
    <text class="section-title">路由测试</text>
    <button class="btn btn-primary" bindtap="navigateToTest">跳转到测试页</button>
    <button class="btn btn-primary" bindtap="switchToTest">切换到测试页</button>
  </view>

  <view class="section">
    <text class="section-title">API 测试</text>
    <button class="btn btn-success" bindtap="testStorage">测试 Storage</button>
    <button class="btn btn-success" bindtap="testRequest">测试网络请求</button>
    <button class="btn btn-success" bindtap="testSystemInfo">获取系统信息</button>
  </view>

  <view class="section">
    <text class="section-title">UI 测试</text>
    <button class="btn btn-warning" bindtap="showToast">显示 Toast</button>
    <button class="btn btn-warning" bindtap="showModal">显示 Modal</button>
    <button class="btn btn-warning" bindtap="showLoading">显示 Loading</button>
  </view>

  <view class="section">
    <text class="section-title">数据绑定测试</text>
    <view class="data-row">
      <text>计数器: {{count}}</text>
      <button class="btn-mini" bindtap="increment">+1</button>
    </view>
    <view class="data-row">
      <text>文本: {{message}}</text>
    </view>
    <input class="input" placeholder="输入文本" bindinput="onInput" value="{{inputValue}}" />
  </view>

  <view class="section">
    <text class="section-title">列表渲染测试</text>
    <view class="list">
      <view class="list-item" wx:for="{{items}}" wx:key="id">
        <text>{{index + 1}}. {{item.name}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">条件渲染测试</text>
    <button class="btn btn-primary" bindtap="toggleShow">切换显示</button>
    <view class="message" wx:if="{{showMessage}}">
      <text>这是一个条件渲染的消息</text>
    </view>
  </view>
</view>
