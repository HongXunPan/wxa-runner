<view class="container">
  <view class="header">
    <text class="title">测试页面</text>
  </view>

  <view class="section">
    <text class="section-title">页面生命周期</text>
    <view class="log-box">
      <text class="log-item" wx:for="{{logs}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">返回测试</text>
    <button class="btn btn-primary" bindtap="navigateBack">返回上一页</button>
    <button class="btn btn-primary" bindtap="reLaunch">重新启动</button>
  </view>

  <view class="section">
    <text class="section-title">接收参数</text>
    <text>来源页面: {{from}}</text>
  </view>
</view>
