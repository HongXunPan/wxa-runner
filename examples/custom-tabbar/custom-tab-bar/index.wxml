<view class="custom-tabs">
  <view id="tab-selected" data-testid="tab-selected">选中：{{selected}}</view>
  <view id="tab-taps" data-testid="tab-taps">点击：{{taps}}</view>
  <view id="tab-home" data-testid="tab-home" data-index="0" data-path="/pages/home/index" bindtap="switch"><tab-label label="首页" /></view>
  <view id="tab-mine" data-testid="tab-mine" data-index="1" data-path="/pages/mine/index" bindtap="switch"><tab-label label="我的" /></view>
</view>
