/* app.wxss */
page {
  background-color: #f8f8f8;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
}

/* 全局按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
  margin: 20rpx 0;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
}

.btn-success {
  background: #07c160;
  color: #ffffff;
}

.btn-warning {
  background: #ff9500;
  color: #ffffff;
}
